# Copie para .env. Tudo aqui é opcional em desenvolvimento, exceto ADMIN_TOKEN para usar o painel.
API_ADDR=127.0.0.1:8080
DATABASE_PATH=data/mrjapa.db

# Endereço público do site, usado no link enviado ao cliente pelo bot do WhatsApp.
SITE_URL=http://localhost:3000

# Painel /admin. Sem este valor o painel fica desligado. Gere com: openssl rand -hex 32
ADMIN_TOKEN=

# Número do restaurante com DDI e DDD, só dígitos (ex.: 5511999999999). Sem ele, o botão "Enviar pelo WhatsApp" some do site.
WHATSAPP_NUMBER=

# Entrega. Taxa em centavos; 0 = "a combinar na confirmação".
DELIVERY_ENABLED=true
DELIVERY_FEE_CENTS=0

# Dados exibidos em Localização e Contato. Campos vazios não aparecem no site.
RESTAURANT_ADDRESS=
RESTAURANT_HOURS=
RESTAURANT_PHONE=
RESTAURANT_EMAIL=
RESTAURANT_INSTAGRAM=
RESTAURANT_MAP_URL=
